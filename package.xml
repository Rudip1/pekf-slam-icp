<?xml version="1.0"?>
<package format="2">
  <name>localization</name>
  <version>0.1.0</version>
  <description>
    Pose-based EKF SLAM for a differential-drive robot: wheel odometry and IMU
    heading for prediction, ICP laser scan matching for correction.
  </description>

  <!-- TODO: replace with a public contact address for the maintainer. -->
  <maintainer email="maintainer@example.com">Pravin Oli</maintainer>
  <author>Pravin Oli</author>
  <author>Gebrecherkos G.</author>

  <license>Apache-2.0</license>

  <url type="repository">https://github.com/Rudip1/pekf-slam-icp</url>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend>
  <exec_depend>laser_geometry</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- Open3D is installed with pip, see requirements.txt. -->

  <!-- Used only by the launch files. -->
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>rqt_robot_steering</exec_depend>
  <exec_depend>rviz</exec_depend>
</package>
