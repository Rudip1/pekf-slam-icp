<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pekf_slam_icp</name>
  <version>1.0.0</version>
  <description>Pose-based EKF SLAM with ICP scan matching for a differential-drive robot with a 2-D lidar (ROS 2).</description>
  <maintainer email="olipravin18@gmail.com">Pravin Oli</maintainer>
  <license>Apache-2.0</license>
  <author>Pravin Oli</author>
  <author>Gebrecherkos Gebreslassie</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>git</buildtool_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>

  <exec_depend>rclpy</exec_depend>

  <exec_depend>pekf_slam_icp_gazebo</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
